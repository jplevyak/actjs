{
  "name": "actjs",
  "version": "0.3.0",
  "description": "A small JavaScript actor framework with optimistic-concurrency transactions backed by Redis.",
  "type": "module",
  "main": "dist/main.js",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./actor": {
      "types": "./dist/actor.d.ts",
      "import": "./dist/actor.js"
    },
    "./event-sourced": {
      "types": "./dist/event-sourced.d.ts",
      "import": "./dist/event-sourced.js"
    },
    "./replica": {
      "types": "./dist/replica.d.ts",
      "import": "./dist/replica.js"
    },
    "./handler": {
      "types": "./dist/handler.d.ts",
      "import": "./dist/handler.js"
    },
    "./legacy": {
      "types": "./dist/legacy/shim.d.ts",
      "import": "./dist/legacy/shim.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "import": "./dist/codegen/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./wire": {
      "types": "./dist/wire/index.d.ts",
      "import": "./dist/wire/index.js"
    },
    "./bindings": {
      "types": "./dist/bindings/index.d.ts",
      "import": "./dist/bindings/index.js"
    },
    "./bindings/react": {
      "types": "./dist/bindings/react.d.ts",
      "import": "./dist/bindings/react.js"
    },
    "./bindings/svelte": {
      "types": "./dist/bindings/svelte.d.ts",
      "import": "./dist/bindings/svelte.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "import": "./dist/policy/index.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "import": "./dist/test/index.js"
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "svelte": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "bin": {
    "actctl": "./dist/cli/actctl.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo coverage",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "demo": "./demo.bash",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/websocket": "^11.2.0",
    "fast-json-patch": "^3.1.1",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "immer": "^11.1.8",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0",
    "semver": "^7.8.0",
    "typescript": "^5.6.3",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.17.6",
    "@types/pg": "^8.20.0",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^2.1.5",
    "eslint": "^9.15.0",
    "eslint-plugin-import": "^2.31.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  }
}
